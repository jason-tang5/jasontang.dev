{
  "name": "jason-tang-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:chat": "npm run build && npx wrangler dev --config wrangler.chat-local.jsonc --ip 127.0.0.1 --port 8787",
    "test:chat": "node --test tests/chat.test.mjs",
    "test:chat:browser": "node tests/chat-browser.mjs",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "obscenity": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-video-ascii": "1.5.1",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.152.0"
  }
}
